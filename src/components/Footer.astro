---
import Pagination from '@astrojs/starlight/components/Pagination.astro'

// The splash home has no previous/next page, so Starlight's Pagination would
// render an empty bordered box at the bottom of the one-screen hero.
const { entry } = Astro.locals.starlightRoute
const isHome = entry?.id === ''
---

{
  !isHome && (
    <footer class="k-footer">
      <Pagination />
    </footer>
  )
}
