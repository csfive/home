---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import '../styles/landing.css'

const frontmatter = {
  title: '计算机废物自学指北',
  description: '计算机废物自学指北，@mancuoj 的自学笔记',
  template: 'splash',
}

const arrow =
  'M17.92 11.62a1.001 1.001 0 0 0-.21-.33l-5-5a1.003 1.003 0 1 0-1.42 1.42l3.3 3.29H7a1 1 0 0 0 0 2h7.59l-3.3 3.29a1.002 1.002 0 0 0 .325 1.639 1 1 0 0 0 1.095-.219l5-5a1 1 0 0 0 .21-.33 1 1 0 0 0 0-.76Z'
---

<StarlightPage frontmatter={frontmatter} hasSidebar={false}>
  <div class="k-landing not-content">
    <section class="k-hero" aria-labelledby="_top">
      <div class="k-hero__inner">
        <div class="k-hero__top">
          <p class="k-eyebrow" data-pagefind-ignore>SELF-TAUGHT CS · NOTES BY @MANCUOJ</p>
          <span class="k-hero__mascot" aria-hidden="true">
            <img src="/logo.svg" width="64" height="64" alt="" />
          </span>
        </div>

        <h1 class="k-hero__title" id="_top">计算机废物<span>自学指北</span></h1>

        <p class="k-hero__lede">自学计算机的两条线：从 Shell 到工具链，从 Pong 到 Pokémon。</p>

        <div class="k-hero__actions">
          <a class="k-btn k-btn--primary" href="/roadmap">
            从路线图开始
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
              ><path d={arrow}></path></svg
            >
          </a>
          <a class="k-btn" href="https://github.com/csfive/home" target="_blank" rel="noopener">
            GitHub
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 4h6v6"></path><path d="M20 4 10 14"></path>
              <path d="M20 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h5"></path>
            </svg>
          </a>
        </div>

        <ul class="k-hero__stats" data-pagefind-ignore>
          <li>2 个系列</li>
          <li>17 篇笔记</li>
          <li>1 张路线图</li>
        </ul>
      </div>
    </section>

    <section class="k-section" aria-labelledby="series-title">
      <header class="k-section__head">
        <p class="k-eyebrow">COLLECTIONS / 系列</p>
        <h2 class="k-section__title" id="series-title">两个系列</h2>
        <span class="k-section__note">按顺序读，或挑感兴趣的</span>
      </header>

      <div class="k-series">
        <a class="k-series__item" href="/ms/00">
          <span class="k-series__top" data-pagefind-ignore>
            <span class="k-series__index">01</span>
            <span>9 篇笔记</span>
          </span>
          <span class="k-series__kicker" data-pagefind-ignore>MIT MISSING SEMESTER</span>
          <span class="k-series__title">Missing Semester</span>{' '}
          <span class="k-series__desc">
            Shell、命令行、调试、Git 与打包发布，补齐课堂不教的那部分。
          </span>
          <span class="k-series__link" data-pagefind-ignore>
            进入系列
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={arrow}></path>
            </svg>
          </span>
        </a>

        <a class="k-series__item" href="/cs50g/00">
          <span class="k-series__top" data-pagefind-ignore>
            <span class="k-series__index">02</span>
            <span>8 篇笔记</span>
          </span>
          <span class="k-series__kicker" data-pagefind-ignore>HARVARD CS50 2D GAME</span>
          <span class="k-series__title">CS50 2D Game</span>{' '}
          <span class="k-series__desc">
            用 Lua 和 LÖVE 写游戏：从 Pong、Flappy Bird 一路做到 Pokémon。
          </span>
          <span class="k-series__link" data-pagefind-ignore>
            进入系列
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={arrow}></path>
            </svg>
          </span>
        </a>
      </div>
    </section>

    <section class="k-section" aria-labelledby="roadmap-title">
      <a class="k-roadmap__link" href="/roadmap">
        <span class="k-roadmap__label" data-pagefind-ignore>ROADMAP / 路线图</span>
        <div class="k-roadmap__copy">
          <h2 class="k-roadmap__title" id="roadmap-title">从 CS50x 到 CS61C</h2>
          <span class="k-roadmap__desc">
            按依赖关系排好的自学路径：先打基础，再往系统与语言深处走。
          </span>
        </div>
        <span class="k-roadmap__cta" data-pagefind-ignore>
          查看路线图
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={arrow}></path>
          </svg>
        </span>
      </a>
    </section>

    <section class="k-cta" aria-labelledby="cta-title">
      <p class="k-eyebrow" data-pagefind-ignore>START HERE / 从这里开始</p>
      <h2 class="k-cta__title" id="cta-title">今天，先读完一讲。</h2>
      <div class="k-cta__actions">
        <a class="k-btn k-btn--primary" href="/ms/00">
          从第一讲开始
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d={arrow}></path></svg
          >
        </a>
        <a class="k-btn" href="/cs50g/00">
          挑一个游戏
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path d={arrow}></path></svg
          >
        </a>
      </div>
      <p class="k-cta__note" data-pagefind-ignore>笔记持续更新，最新进度见 GitHub。</p>
    </section>

    <footer class="k-footer-landing" data-pagefind-ignore>
      <span>© 2026 CS Five</span>
      <span class="k-footer-landing__spacer"></span>
      <span>Astro · Starlight</span>
      <a href="https://github.com/csfive/home" target="_blank" rel="noopener">GitHub ↗</a>
    </footer>
  </div>
</StarlightPage>
